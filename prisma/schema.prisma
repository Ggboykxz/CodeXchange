generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  nom          String
  slug         String   @unique
  titre        String
  ville        String
  pays         String
  bio          String   @default("")
  avatar       String   @default("") // data URL (base64) ou "" 
  stack        String   @default("")
  github       String   @default("")
  notifEmail   Boolean  @default(true)
  linkedin     String   @default("")
  site         String   @default("")
  role         String   @default("MEMBER") // MEMBER | MENTOR | ADMIN
  bannedAt     DateTime?
  createdAt    DateTime @default(now())

  sessions   Session[]
  pollVotes  PollVote[]
  passwordResets PasswordResetToken[]
  tagFollows TagFollow[]
  posts      Post[]
  replies    Reply[]
  likes      Like[]
  replyLikes ReplyLike[] @relation("ReplyLikes")
  messagesEnvoyes Message[] @relation("SentMessages")
  messagesRecus   Message[] @relation("ReceivedMessages")
  jobs       Job[]
  candidatures Application[]
  projets    Project[]        @relation("ProjectOwner")
  rejoins    ProjectMember[]
  rsvps      Rsvp[]
  tutos      Tutorial[]
  mentorat   MentorRequest[] @relation("Mentor")
  demandes   MentorRequest[] @relation("Requester")
  notifications Notification[]
  favoris       Favorite[]
  signalements  Report[] @relation("Reporter")
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id        Int      @id @default(autoincrement())
  titre     String
  corps     String
  tags      String   @default("")
  type      String   @default("text")
  authorId  Int
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   Reply[]
  likes     Like[]
  poll      Poll?
}

model Reply {
  id        Int      @id @default(autoincrement())
  corps     String
  postId    Int
  authorId  Int
  parentId  Int?
  deletedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Reply?   @relation("ReplyThread", fields: [parentId], references: [id], onDelete: Cascade)
  children  Reply[]  @relation("ReplyThread")
  likes     ReplyLike[]
}

model ReplyLike {
  replyId Int
  userId  Int
  reply   Reply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user    User  @relation("ReplyLikes", fields: [userId], references: [id], onDelete: Cascade)
  @@id([replyId, userId])
}

model Message {
  id          Int      @id @default(autoincrement())
  senderId    Int
  recipientId Int
  corps       String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
}

model Like {
  userId Int
  postId Int
  valeur Int @default(1) // +1 upvote, -1 downvote
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Job {
  id            Int           @id @default(autoincrement())
  titre         String
  entreprise    String
  contrat       String // CDI | Freelance | Stage | Alternance
  remote        Boolean       @default(false)
  pays          String
  ville         String        @default("")
  lien          String
  authorId      Int
  createdAt     DateTime      @default(now())
  auteur        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  candidatures  Application[]
}

model Application {
  id        Int      @id @default(autoincrement())
  jobId     Int
  userId    Int
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
}

model Project {
  id          Int             @id @default(autoincrement())
  titre       String
  description String
  stack       String          @default("")
  cherche     String          @default("")
  lien        String          @default("")
  authorId    Int
  createdAt   DateTime        @default(now())
  author      User            @relation("ProjectOwner", fields: [authorId], references: [id], onDelete: Cascade)
  membres     ProjectMember[]
}

model ProjectMember {
  projectId Int
  userId    Int
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Event {
  id          Int      @id @default(autoincrement())
  titre       String
  description String
  date        DateTime
  format      String // Présentiel | En ligne
  ville       String   @default("")
  pays        String   @default("")
  lien        String   @default("")
  createdAt   DateTime @default(now())
  rsvps       Rsvp[]
}

model Rsvp {
  eventId   Int
  userId    Int
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Tutorial {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  titre     String
  resume    String
  corps     String
  tags      String   @default("")
  dureeMin  Int      @default(5)
  authorId  Int
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model MentorRequest {
  id          Int      @id @default(autoincrement())
  mentorId    Int
  requesterId Int
  message     String
  createdAt   DateTime @default(now())
  mentor      User     @relation("Mentor", fields: [mentorId], references: [id], onDelete: Cascade)
  requester   User     @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([mentorId, requesterId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  text      String
  lien      String   @default("")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Poll {
  id        Int      @id @default(autoincrement())
  postId    Int      @unique
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  question  String
  createdAt DateTime @default(now())
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id      Int      @id @default(autoincrement())
  pollId  Int
  poll    Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label   String
  votes   PollVote[]
}

model PollVote {
  userId   Int
  pollId   Int
  optionId Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll     Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, pollId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  kind      String   // post | job | projet | tuto | event | membre
  targetId  Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
}


model Report {
  id          Int       @id @default(autoincrement())
  reporterId  Int
  kind        String    // post | reply | job | projet | evenement | tuto | membre | message
  targetId    Int
  raison      String
  statut      String    @default("PENDING") // PENDING | TRAITE | REJETE
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedById Int?
  reporter    User      @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model TagFollow {
  userId Int
  tag    String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, tag])
}
